# Configuración de variables de entorno para KickoffAgent (Plantilla de ejemplo)
# Si usas Groq (qwen/qwen3.8-27b): https://console.groq.com/keys
GROQ_API_KEY=

# Si usas OpenAI (gpt-4o-mini / gpt-4o): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Precios por millón de tokens para cálculo de costo (opcional)
PRICE_INPUT_PER_1M=0
PRICE_OUTPUT_PER_1M=0