# Configuración de variables de entorno para KickoffAgent (Plantilla de ejemplo)
# Si usas Groq (qwen/qwen3.8-27b): https://console.groq.com/keys
GROQ_API_KEY=

# Si usas OpenAI (gpt-4o-mini / gpt-4o): https://platform.openai.com/api-keys
# Si está configurada, el juez de evaluación y los guardrails usan gpt-4o-mini.
OPENAI_API_KEY=

# Precios por millón de tokens para cálculo de costo (opcional)
PRICE_INPUT_PER_1M=0
PRICE_OUTPUT_PER_1M=0

# OpenTelemetry / Grafana LGTM (opcional)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Supabase (opcional, necesario para n8n y Grafana)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=6543
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# n8n W2 (opcional)
UMBRAL_TASA_ERROR=0.1
UMBRAL_P95_MS=30000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=