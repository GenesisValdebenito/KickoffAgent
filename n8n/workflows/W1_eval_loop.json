{
  "name": "W1 - Loop de evaluación",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "minutes", "minutesInterval": 60 }
          ]
        }
      },
      "id": "11111111-1111-4111-8111-111111111111",
      "name": "Cada 60 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.KICKOFF_API_URL }}/eval",
        "sendQueryParameters": true,
        "specifyQueryParameters": true,
        "queryParameters": {
          "parameters": [
            { "name": "limite", "value": "15" }
          ]
        },
        "options": { "timeout": 900000 }
      },
      "id": "22222222-2222-4222-8222-222222222222",
      "name": "POST /eval",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst resumen = { ...r };\ndelete resumen.resultados;\nreturn [{\n  json: {\n    fecha: r.timestamp || new Date().toISOString(),\n    resumen: resumen,\n    detalle: r.resultados || []\n  }\n}];"
      },
      "id": "33333333-3333-4333-8333-333333333333",
      "name": "Preparar fila evals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/evals",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": { "timeout": 30000 }
      },
      "id": "44444444-4444-4444-8444-444444444444",
      "name": "Insertar en Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    },
    {
      "parameters": {},
      "id": "55555555-5555-4555-8555-555555555555",
      "name": "Fin",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1120, 300]
    }
  ],
  "connections": {
    "Cada 60 minutos": {
      "main": [[{ "node": "POST /eval", "type": "main", "index": 0 }]]
    },
    "POST /eval": {
      "main": [[{ "node": "Preparar fila evals", "type": "main", "index": 0 }]]
    },
    "Preparar fila evals": {
      "main": [[{ "node": "Insertar en Supabase", "type": "main", "index": 0 }]]
    },
    "Insertar en Supabase": {
      "main": [[{ "node": "Fin", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "versionId": "1",
  "meta": {}
}
