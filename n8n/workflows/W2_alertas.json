{
  "name": "W2 - Alertas por umbrales",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "minutes", "minutesInterval": 15 }
          ]
        }
      },
      "id": "a1111111-1111-4111-8111-111111111111",
      "name": "Cada 15 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.KICKOFF_API_URL }}/metrics",
        "options": { "timeout": 30000 }
      },
      "id": "a2222222-2222-4222-8222-222222222222",
      "name": "GET /metrics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const m = $input.first().json;\nconst limiteError = Number($env.UMBRAL_TASA_ERROR || 0.1);\nconst limiteP95 = Number($env.UMBRAL_P95_MS || 30000);\nconst alertas = [];\nif (m.tasa_error > limiteError) alertas.push(`Tasa de error ${m.tasa_error} supera ${limiteError}`);\nif (m.latencia_p95_ms > limiteP95) alertas.push(`p95 ${m.latencia_p95_ms} ms supera ${limiteP95} ms`);\nreturn [{ json: {\n  debe_alertar: alertas.length > 0,\n  mensaje: alertas.length > 0 ? `KickoffAgent ALERTA: ${alertas.join(' | ')}` : 'Sin anomalías',\n  metricas: m,\n  alertas: alertas\n}}];"
      },
      "id": "a3333333-3333-4333-8333-333333333333",
      "name": "Evaluar umbrales",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "conditions": [
            {
              "id": "condicion_alerta",
              "leftValue": "={{ $json.debe_alertar }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ]
        },
        "options": {}
      },
      "id": "a4444444-4444-4444-8444-444444444444",
      "name": "¿Hay anomalía?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $env.TELEGRAM_CHAT_ID, text: $json.mensaje }) }}",
        "options": { "timeout": 30000 }
      },
      "id": "a5555555-5555-4555-8555-555555555555",
      "name": "Enviar Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 200]
    },
    {
      "parameters": {},
      "id": "a6666666-6666-4666-8666-666666666666",
      "name": "Sin alerta",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1120, 400]
    }
  ],
  "connections": {
    "Cada 15 minutos": {
      "main": [[{ "node": "GET /metrics", "type": "main", "index": 0 }]]
    },
    "GET /metrics": {
      "main": [[{ "node": "Evaluar umbrales", "type": "main", "index": 0 }]]
    },
    "Evaluar umbrales": {
      "main": [[{ "node": "¿Hay anomalía?", "type": "main", "index": 0 }]]
    },
    "¿Hay anomalía?": {
      "main": [
        [{ "node": "Enviar Telegram", "type": "main", "index": 0 }],
        [{ "node": "Sin alerta", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "versionId": "1",
  "meta": {}
}
