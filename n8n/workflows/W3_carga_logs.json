{
  "name": "W3 - Carga de logs",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "minutes", "minutesInterval": 30 }
          ]
        }
      },
      "id": "b1111111-1111-4111-8111-111111111111",
      "name": "Cada 30 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.KICKOFF_API_URL }}/logs",
        "sendQueryParameters": true,
        "specifyQueryParameters": true,
        "queryParameters": {
          "parameters": [
            { "name": "limite", "value": "1000" }
          ]
        },
        "options": { "timeout": 30000 }
      },
      "id": "b2222222-2222-4222-8222-222222222222",
      "name": "GET /logs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const eventos = $input.first().json.eventos || [];\nreturn eventos.map((e) => ({\n  json: {\n    trace_id: e.trace_id || null,\n    thread_id: e.thread_id || null,\n    tipo: e.tipo || null,\n    timestamp: e.timestamp || null,\n    ruta: e.ruta || null,\n    herramientas: e.herramientas || [],\n    chunks_recuperados: e.chunks_recuperados || 0,\n    latencia_ms: e.latencia_ms || null,\n    tokens: e.tokens || {},\n    error: e.error || null,\n    salida: (e.salida || '').slice(0, 2000)\n  }\n}));"
      },
      "id": "b3333333-3333-4333-8333-333333333333",
      "name": "Mapear a tabla logs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/logs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($input.all().map(i => i.json)) }}",
        "options": { "timeout": 30000 }
      },
      "id": "b4444444-4444-4444-8444-444444444444",
      "name": "Insertar en Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    },
    {
      "parameters": {},
      "id": "b5555555-5555-4555-8555-555555555555",
      "name": "Fin",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1120, 300]
    }
  ],
  "connections": {
    "Cada 30 minutos": {
      "main": [[{ "node": "GET /logs", "type": "main", "index": 0 }]]
    },
    "GET /logs": {
      "main": [[{ "node": "Mapear a tabla logs", "type": "main", "index": 0 }]]
    },
    "Mapear a tabla logs": {
      "main": [[{ "node": "Insertar en Supabase", "type": "main", "index": 0 }]]
    },
    "Insertar en Supabase": {
      "main": [[{ "node": "Fin", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "versionId": "1",
  "meta": {}
}
